# Data: the raw sources and the processed tables are not versioned. The notebooks rebuild data/processed/ from
# data/raw/ (README, How to run); the website only needs frontend/data/. The lines further down that name
# single files stay, for the files whose terms forbid redistribution.
data/raw/
data/processed/

# Python (every __pycache__ folder, at any depth)
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Source data too large for GitHub (100 MB limit): download V-Dem Country-Year Core v16
# from https://v-dem.net/data/the-v-dem-dataset/ and save it as data/raw/V-Dem-CY-Core-v16.csv
data/raw/V-Dem-CY-Core-v16.csv
# Same page, "Country-Year: V-Dem Full+Others v16", CSV format (406 MB)
data/raw/V-Dem-CY-Full+Others-v16.csv
# Sources of notebooks/04_demographics.ipynb that must not be redistributed (the notebook downloads them if missing):
# QoG Standard data: "We do not allow other uses of these data including ... redistribution" (gu.se/en/quality-government)
data/raw/qog_std_cs_jan26.csv
# EPR Core 2021 (ETH Zurich): free download with a citation request, but no licence allowing redistribution
data/raw/EPR-2021.csv
# Sources of notebooks/05_shocks.ipynb that must not be redistributed (the notebook downloads them if missing):
# EM-DAT archive (CRED, UCLouvain): CC BY-NC-ND 4.0, no distribution of adapted data
data/raw/260430_emdat_archive.xlsx
# PRIO Battle Deaths 3.1 and the World Peace Foundation's famine list: free download, no licence stated
data/raw/PRIO_BattleDeaths_v3.1.xls
data/raw/owid_famines.csv
data/raw/owid_famines.metadata.json
# Tables of notebooks/05_shocks.ipynb that contain values derived from EM-DAT (regenerated by the notebook)
data/processed/shocks_country_year.csv
data/processed/ml_timevarying_shocks.csv

# Source of notebooks/06_party_leaders.ipynb that must not be redistributed (src/download_party_leader_data.py
# downloads it again): LEAD, no licence stated for the data
data/raw/lead/
# Tables of notebooks/06_party_leaders.ipynb that contain LEAD values (regenerated by the notebook)
data/processed/ml_static_leaders.csv
data/processed/ml_timevarying_leaders.csv

# Regenerable by notebooks/03_ml_survival.ipynb (146,200 out-of-fold predictions)
data/processed/ml_oof_taskB.csv

# Local copy of the results before the October 2026 corrections (before/after comparison only)
data/processed/avant_option_A/

# Cache of the Wikimedia API answers of frontend/build_media.py (the results are in data/raw/wikimedia_atlas.json)
data/raw/wikimedia_cache/

# Tables of notebooks/04_demographics.ipynb that contain QoG and EPR values, which must not be redistributed
# (regenerated by the notebook)
data/processed/demo_country_year.csv
data/processed/ml_static_demo.csv
data/processed/ml_timevarying_demo.csv

# Local backups (copies made before a file is overwritten) and scratch files
notebooks/_sauvegarde/
scratch/
